  </div>

  <script>
    const translations = {
      no: {
        'title': 'Takk for svar',
        'subline': 'Du blir savnet',
        'message': 'Det er synd du ikke kan være med oss til Svartehavet, men vi forstår. Du er i tankene våre den store dagen – og vi skåler en ekstra gang for deg fra Bulgaria.',
        'back-link': 'Tilbake til siden'
      },
      en: {
        'title': 'Thank You',
        'subline': 'You will be missed',
        'message': "We're sad you can't join us on the Black Sea coast, but we understand. You'll be in our thoughts on the big day – and we'll raise an extra glass to you from Bulgaria.",
        'back-link': 'Back to home'
      },
      bg: {
        'title': 'Благодарим за отговора',
        'subline': 'Ще ни липсваш',
        'message': 'Жалко, че не можеш да дойдеш с нас на Черно море, но разбираме. Ще бъдеш в мислите ни в големия ден – и ще вдигнем една допълнителна чаша за теб от България.',
        'back-link': 'Обратно към начало'
      }
    };

    let currentLang = 'no';

    function setLanguage(lang) {
      currentLang = lang;
      document.documentElement.lang = lang;

      document.querySelectorAll('[data-text]').forEach(element => {
        const key = element.dataset.text;
        if (translations[lang] && translations[lang][key]) {
          element.textContent = translations[lang][key];
        }
      });

      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      document.querySelector(`[data-lang="${lang}"]`).classList.add('active');

      localStorage.setItem('preferred-language', lang);
    }

    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        setLanguage(this.dataset.lang);
      });
    });

    window.addEventListener('load', function() {
      const saved = localStorage.getItem('preferred-language');
      const browserLang = navigator.language.split('-')[0];
      const lang = saved || (browserLang === 'en' || browserLang === 'bg' ? browserLang : 'no');

      if (['no', 'en', 'bg'].includes(lang)) {
        setLanguage(lang);
      }
    });
  </script>

</body>
</html>
