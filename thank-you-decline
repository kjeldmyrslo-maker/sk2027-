  <title>Takk for svar — Silje & Kjeld</title>

  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&family=Cinzel:wght@400;600&display=swap" rel="stylesheet" />

  <style>
    :root {
      --gold: #B08D57;
      --gold-light: #D4B896;
      --deep: #2C2420;
      --stone-light: #8C8480;
      --ivory-dark: #F7F4F0;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: var(--ivory-dark);
      color: var(--deep);
      padding: 2rem;
      font-family: 'Cormorant Garamond', serif;
    }

    .lang-switcher {
      position: fixed;
      top: 1rem;
      right: 1rem;
      display: flex;
      gap: 0.5rem;
      z-index: 100;
    }

    .lang-btn {
      padding: 0.5rem 1rem;
      border: 1px solid var(--gold);
      background: #fff;
      color: var(--gold);
      font-family: 'Cinzel', serif;
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.3s;
    }

    .lang-btn:hover {
      background: var(--gold);
      color: #fff;
    }

    .lang-btn.active {
      background: var(--gold);
      color: #fff;
    }

    .wrap {
      max-width: 720px;
      background: #fff;
      border: 1px solid var(--gold-light);
      padding: 4rem 2rem;
      animation: fadeUp 0.9s ease both;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      font-family: 'Cormorant Garamond', serif;
      font-size: 3rem;
      font-style: italic;
      color: var(--gold);
      margin-bottom: 1rem;
      letter-spacing: 0.05em;
    }

    .heart-icon {
      display: inline-block;
      width: 0.75em;
      height: 0.75em;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.3;
      stroke-linecap: round;
      stroke-linejoin: round;
      vertical-align: middle;
    }

    .ornament {
      color: var(--gold);
      letter-spacing: 0.3em;
      margin: 1rem 0;
    }

    h1 {
      font-size: clamp(2.5rem, 9vw, 4.5rem);
      font-weight: 300;
      margin-bottom: 1rem;
    }

    .subline {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 1.3rem;
      color: var(--gold);
      margin-bottom: 1.5rem;
    }

    p {
      font-size: 1.2rem;
      line-height: 1.8;
      color: var(--stone-light);
      max-width: 540px;
      margin: 0 auto;
    }

    a {
      display: inline-block;
      margin-top: 2rem;
      text-decoration: none;
      color: var(--gold);
      border: 1px solid var(--gold);
      padding: 1rem 2rem;
      font-family: 'Cinzel', serif;
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      transition: all 0.3s;
    }

    a:hover {
      background: var(--gold);
      color: #fff;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

</head>

